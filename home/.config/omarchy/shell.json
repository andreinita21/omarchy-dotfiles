{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "andrei.workspaces"
        },
        {
          "id": "custom.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "andreinita21.omamonitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": [
        {
          "id": "superwhisper.panel"
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "andrei.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "andrei.gaps"
    },
    {
      "id": "andrei.rounding-blur"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media"
  ],
  "cloneSourceRestores": [
    "custom.media"
  ],
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ]
  }
}

{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "andrei.workspaces"
        },
        {
          "id": "custom.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "andreinita21.omamonitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "id": "andrei.bar"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "andrei.background"
    },
    {
      "id": "andrei.gaps"
    },
    {
      "id": "andrei.rounding-blur"
    },
    {
      "id": "andrei.lock"
    },
    {
      "id": "andrei.idle"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.background",
    "omarchy.lock",
    "omarchy.idle"
  ],
  "cloneSourceRestores": [
    "custom.media",
    "andrei.background",
    "andrei.lock",
    "andrei.idle"
  ]
}

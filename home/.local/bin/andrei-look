#!/bin/bash
# One source of truth for window rounding, blur and transparency, shared by
# Hyprland windows, the terminals and the andrei.bar blur mode, so the bar and
# a terminal next to it look like the same sheet of glass.
#
#   andrei-look get                          print the settings as JSON
#   andrei-look set <rounding> <blur> <opacity> [--live]
#       rounding  0-20   corner radius in px
#       blur      0-100  blur intensity (0 turns blur off)
#       opacity   50-100 terminal background opacity and bar blur-mode alpha
#       --live    apply to Hyprland and the bar only (used while dragging a
#                 slider); without it the terminals are updated too
#   andrei-look apply                         re-apply the saved settings
#
# Hyprland: settings go into ~/.local/state/omarchy/toggles/hypr/zz-andrei-look.lua,
# which Omarchy loads after its own toggles (corners, no-gaps, glassy), so these
# values win on every reload. They are also pushed live with `hyprctl eval`, so
# nothing here ever reloads Hyprland.
#
# Terminals: opacity is set on the background only (foot alpha, alacritty
# opacity, kitty background_opacity, ghostty background-opacity), never with a
# Hyprland window opacity, which would fade the text too.

set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/andrei-look.json"
TOGGLE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/zz-andrei-look.lua"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"

clamp() { local v=${1%.*}; [[ $v =~ ^[0-9]+$ ]] || v=$4; ((v < $2)) && v=$2; ((v > $3)) && v=$3; echo "$v"; }

load() {
  rounding=10 blur=50 opacity=85
  if [[ -f $STATE ]]; then
    eval "$(python3 -I -c '
import json, sys
d = json.load(open(sys.argv[1]))
for k in ("rounding", "blur", "opacity"):
    v = d.get(k)
    if isinstance(v, (int, float)): print(f"{k}={int(v)}")
' "$STATE" 2>/dev/null)"
  fi
}

save() {
  mkdir -p "$(dirname "$STATE")"
  printf '{"rounding": %d, "blur": %d, "opacity": %d}\n' "$rounding" "$blur" "$opacity" >"$STATE.tmp" &&
    mv "$STATE.tmp" "$STATE"
}

lua_config() {
  local enabled=true size passes
  ((blur == 0)) && enabled=false
  size=$((2 + blur / 10))          # 2..12
  passes=$((1 + blur / 34))        # 1..3
  cat <<EOF
-- Generated by andrei-look (Rounding & Blur). Edit with the popup, not here.
hl.config({
  decoration = {
    rounding = $rounding,
    rounding_power = 2,
    active_opacity = 1.0,
    inactive_opacity = 1.0,
    blur = {
      enabled = $enabled,
      size = $size,
      passes = $passes,
      new_optimizations = true,
      ignore_opacity = true,
      xray = false,
      popups = true,
      special = true,
    },
  },
})
EOF
}

apply_hyprland() {
  mkdir -p "$(dirname "$TOGGLE")"
  lua_config >"$TOGGLE.tmp" && mv "$TOGGLE.tmp" "$TOGGLE"
  hyprctl eval "$(cat "$TOGGLE")" >/dev/null 2>&1 || true
}

apply_bar() {
  local alpha
  alpha=$(printf '0.%02d' "$opacity"); ((opacity >= 100)) && alpha=1.0
  omarchy-shell -q omarchy.bar setGlass "$alpha" >/dev/null 2>&1 || true
}

apply_terminals() {
  local alpha
  alpha=$(printf '0.%02d' "$opacity"); ((opacity >= 100)) && alpha=1.0
  [[ -f $CONF/foot/foot.ini ]] && sed -i -E "s/^([[:space:]]*alpha[[:space:]]*=[[:space:]]*).*/\1$alpha/" "$(readlink -f "$CONF/foot/foot.ini")"
  [[ -f $CONF/alacritty/alacritty.toml ]] && sed -i -E "s/^([[:space:]]*opacity[[:space:]]*=[[:space:]]*).*/\1$alpha/" "$(readlink -f "$CONF/alacritty/alacritty.toml")"
  [[ -f $CONF/kitty/kitty.conf ]] && sed -i -E "s/^([[:space:]]*background_opacity[[:space:]]+).*/\1$alpha/" "$(readlink -f "$CONF/kitty/kitty.conf")"
  [[ -f $CONF/ghostty/config ]] && sed -i -E "s/^([[:space:]]*background-opacity[[:space:]]*=[[:space:]]*).*/\1$alpha/" "$(readlink -f "$CONF/ghostty/config")"
  # Alacritty reloads by itself; this nudges kitty and ghostty. foot reads its
  # config per window, so new foot windows pick it up.
  omarchy-restart-terminal >/dev/null 2>&1 || true
}

case "${1:-get}" in
  get)
    load
    printf '{"rounding": %d, "blur": %d, "opacity": %d}\n' "$rounding" "$blur" "$opacity"
    ;;
  set)
    load
    rounding=$(clamp "${2:-$rounding}" 0 20 "$rounding")
    blur=$(clamp "${3:-$blur}" 0 100 "$blur")
    opacity=$(clamp "${4:-$opacity}" 50 100 "$opacity")
    save
    apply_hyprland
    apply_bar
    [[ ${5:-} == --live ]] || apply_terminals
    ;;
  apply)
    load
    apply_hyprland
    apply_bar
    apply_terminals
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac

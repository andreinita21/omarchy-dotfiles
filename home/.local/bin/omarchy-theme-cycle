#!/bin/bash
# Cycle to the next or previous theme in ~/.config/omarchy/theme-order order.
#
# Usage: omarchy-theme-cycle [next|prev]

direction="${1:-next}"

# Serialize our own read-then-set. omarchy-theme-set locks only while it swaps
# the theme in, so without this a second keypress can read the old current
# theme and land on the same one twice.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-theme-cycle.lock"
flock 9

slug() { tr '[:upper:]' '[:lower:]' | tr ' ' '-'; }

mapfile -t themes < <(/home/andrei/.local/bin/omarchy-theme-list-ordered)
((${#themes[@]} > 1)) || exit 0

current=$(omarchy-theme-current | slug)

index=0
for i in "${!themes[@]}"; do
  if [[ $(printf '%s' "${themes[$i]}" | slug) == "$current" ]]; then
    index=$i
    break
  fi
done

case "$direction" in
  prev | previous) target=$(((index - 1 + ${#themes[@]}) % ${#themes[@]})) ;;
  *) target=$(((index + 1) % ${#themes[@]})) ;;
esac

omarchy-theme-set "${themes[$target]}"

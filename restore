#!/bin/bash
# Selective restore of this repo onto a fresh Omarchy install, with pickers.
#
#   ./restore
#
# Differences from `./dot install`:
#   - NEVER touches the private vault (no keyring/browser/Wi-Fi restore).
#   - Never touches the login manager (SDDM) or the lock screen unless you
#     explicitly pick andrei.lock / andrei.idle.
#   - Lets you pick which Omarchy shell plugins to install, then writes a
#     shell.json that only references what you picked.
#   - Skips packages, AUR builds and services that belong to the Apple Silicon
#     machines (asahi, gravity kernel, m1n1, U-Boot, j773g, ...).
#   - ~/.config/omarchy is linked item by item instead of as one directory, so
#     plugins already on this machine (e.g. superwhisper-panel) survive.
#
# Every replaced file goes to ~/.local/state/dotfiles-backup/<timestamp>/.

set -uo pipefail

DOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_HOME="$DOT/home"
BACKUP="$HOME/.local/state/dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
OMA="$HOME/.config/omarchy"

c_blue=$'\e[34m' c_green=$'\e[32m' c_yellow=$'\e[33m' c_red=$'\e[31m' c_off=$'\e[0m'
step() { printf '\n%s==> %s%s\n' "$c_blue" "$*" "$c_off"; }
ok()   { printf '  %s✓%s %s\n' "$c_green" "$c_off" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_yellow" "$c_off" "$*"; }
err()  { printf '  %s✗%s %s\n' "$c_red" "$c_off" "$*"; }
entries() { [[ -f $1 ]] && sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$'; }
# Non-interactive mode: RESTORE_PLUGINS="id id..." RESTORE_PKGS=all|none
# RESTORE_YES="tweaks dev dconf claude" (steps to run; anything else is skipped).
# With SUDO_ASKPASS set, sudo runs through it instead of prompting on a tty.
NONINTERACTIVE=${RESTORE_PLUGINS+1}
confirm() { # confirm <key> <question> [default true|false]
  if [[ -n $NONINTERACTIVE ]]; then [[ " ${RESTORE_YES:-} " == *" $1 "* ]]; return; fi
  gum confirm "$2" ${3:+--default=$3}
}
[[ -n ${SUDO_ASKPASS:-} ]] && sudo() { command sudo -A "$@"; }

backup() {
  local target=$1 rel=${1#"$HOME"/}
  mkdir -p "$BACKUP/$(dirname "$rel")"
  mv "$target" "$BACKUP/$rel"
  warn "backed up $rel"
}

link() { # link <rel path under $HOME>
  local rel=$1 src="$REPO_HOME/$1" dst="$HOME/$1"
  [[ -e $src || -L $src ]] || { warn "not in repo: $rel"; return; }
  [[ -L $dst && $(readlink "$dst") == "$src" ]] && return
  [[ -e $dst || -L $dst ]] && backup "$dst"
  mkdir -p "$(dirname "$dst")"
  ln -s "$src" "$dst" && ok "$rel"
}

# Things that only make sense on the Apple Silicon Macs, or that would fight
# with what Omarchy already ships on this machine.
SKIP_PKG='asahi|archlinuxarm|gravity|m1n1|uboot|j773g|omarchy-mac|avd|widevine|^qemu-|^omarchy-dev$|^omarchy-settings-dev$'
SKIP_UNIT='j773g|mac-|asahi|speakersafetyd|vendor-firmware|wifi-resume-fix|sleep-lock|recover-internal-monitor|^sddm|greetd|gdm|lightdm'

# ------------------------------------------------------------------ preflight

command -v omarchy >/dev/null || { err "Omarchy not found."; exit 1; }
[[ -n $NONINTERACTIVE ]] || command -v gum >/dev/null || { err "gum not found (omarchy pkg add gum)."; exit 1; }
[[ $EUID -eq 0 ]] && { err "Run as your user, not root."; exit 1; }
[[ $HOME == "$(cat "$DOT/.source-home" 2>/dev/null)" ]] \
  || { err "This repo's paths are for $(cat "$DOT/.source-home"); use ./dot install for path rewriting."; exit 1; }

[[ -n $NONINTERACTIVE ]] || gum style --border rounded --padding "0 2" --border-foreground 99 \
  "omarchy-dotfiles selective restore" "" \
  "No vault. No login-manager changes. You pick the plugins."

# ------------------------------------------------------------------ plugin picker

declare -A DESC=(
  [andrei.bar]="Custom status bar (transparent / blur / OLED modes)"
  [andrei.workspaces]="Custom workspace indicators (falls back to stock if unpicked)"
  [andrei.background]="⚠ Old fork of stock background; fights Omarchy 4.5 OWE wallpaper engine"
  [andrei.gaps]="Gaps popup (Omarchy menu)"
  [andrei.rounding-blur]="Rounding & blur popup (Omarchy menu)"
  [andrei.idle]="⚠ Replaces stock idle/lock timer; needs andrei-launch-screensaver (not in repo)"
  [andrei.lock]="⚠ Replaces stock LOCK SCREEN; old fork of omarchy.lock (likely the doubled login)"
  [andreinita21.omamonitor]="git: drag-and-drop monitor panel (replaces stock monitor widget)"
  [charlieras262.omablur]="git: Omablur"
  [custom.media]="git: Music Flow media visualizer (replaces stock media)"
  [io.github.thisisgm.omapods]="git: AirPods widget (builds librepods daemon)"
)
ORDER=(andrei.bar andrei.workspaces andrei.background andrei.gaps andrei.rounding-blur
       andreinita21.omamonitor charlieras262.omablur custom.media io.github.thisisgm.omapods
       andrei.idle andrei.lock)
DEFAULT_OFF=" andrei.idle andrei.lock andrei.background "

declare -A GITURL=()
while read -r path url; do
  [[ $path == plugins/* ]] && GITURL[${path#plugins/}]=$url
done < <(entries "$DOT/omarchy/git-clones.txt")

step "Pick the shell plugins to install (space toggles, enter confirms)"
options=() selected=()
for id in "${ORDER[@]}"; do
  label=$(printf '%-28s %s' "$id" "${DESC[$id]}")
  options+=("$label")
  [[ $DEFAULT_OFF == *" $id "* ]] || selected+=("$label")
done
sel_csv=$(IFS=,; echo "${selected[*]}")
if [[ -n $NONINTERACTIVE ]]; then
  read -ra picked <<<"$RESTORE_PLUGINS"
else
  mapfile -t picked < <(gum choose --no-limit --height 15 --selected="$sel_csv" "${options[@]}" | awk '{print $1}')
fi
PICKED=" ${picked[*]} "
ok "picked: ${picked[*]:-(none)}"

# ------------------------------------------------------------------ packages

step "Packages"
missing=$(comm -23 <(entries "$DOT/packages/pacman.txt" | sort -u) <(pacman -Qq | sort -u) \
  | grep -Ev "$SKIP_PKG" | comm -12 - <(pacman -Slq | sort -u))
# Omarchy ships its own power-profiles-daemon build.
pacman -Qq omarchy-power-profiles-daemon &>/dev/null && missing=$(grep -vx power-profiles-daemon <<<"$missing")
if [[ -n $missing ]]; then
  if [[ -n $NONINTERACTIVE ]]; then
    [[ ${RESTORE_PKGS:-none} == all ]] && mapfile -t pkgs <<<"$missing" || pkgs=()
    if ((${#pkgs[@]})) && ! sudo pacman -S --needed --noconfirm "${pkgs[@]}"; then
      warn "batch install failed; retrying one by one"
      for p in "${pkgs[@]}"; do sudo pacman -S --needed --noconfirm "$p" >/dev/null 2>&1 && ok "$p" || warn "could not install $p"; done
    fi
  else
    mapfile -t pkgs < <(gum choose --no-limit --height 20 --header "Packages to install (all preselected)" \
      --selected="$(paste -sd, <<<"$missing")" $missing)
    ((${#pkgs[@]})) && sudo pacman -S --needed "${pkgs[@]}"
  fi
else
  ok "nothing missing"
fi
warn "AUR list skipped: it only contains the Mac boot chain (gravity kernel, m1n1, U-Boot, j773g)"

remove=$(entries "$DOT/packages/remove.txt" | while read -r p; do pacman -Qq "$p" &>/dev/null && echo "$p"; done)
if [[ -n $remove && -z $NONINTERACTIVE ]]; then
  mapfile -t rm_pkgs < <(gum choose --no-limit --header "Remove any of these Omarchy defaults? (none preselected)" $remove)
  ((${#rm_pkgs[@]})) && sudo pacman -Rns "${rm_pkgs[@]}"
fi

# ------------------------------------------------------------------ system tweaks

if confirm tweaks "Apply system tweaks (hide stock themes, /etc tuning: THP, zram, RTC alarm, Wi-Fi region)?"; then
  step "Hiding stock themes"
  conf=/etc/pacman.conf lines=""
  while read -r t; do
    grep -q "^NoExtract = usr/share/omarchy/themes/$t\$" "$conf" && continue
    lines+="NoExtract = usr/share/omarchy/themes/$t"$'\n'"NoExtract = usr/share/omarchy/themes/$t/*"$'\n'
  done < <(entries "$DOT/omarchy/themes-remove.txt")
  if [[ -n $lines ]]; then
    sudo cp "$conf" "$conf.bak.$(date +%s)"
    awk -v add="$lines" '{ print } /^\[options\]/ { printf "%s", add }' "$conf" | sudo tee "$conf.new" >/dev/null \
      && sudo mv "$conf.new" "$conf" && ok "pacman.conf updated"
  fi
  while read -r t; do
    [[ -d /usr/share/omarchy/themes/$t ]] && sudo rm -rf "/usr/share/omarchy/themes/$t" && ok "removed stock theme $t"
  done < <(entries "$DOT/omarchy/themes-remove.txt")

  step "Copying /etc files"
  while IFS= read -r f; do
    [[ -f $DOT/system/etc/${f#/etc/} ]] || continue
    sudo install -D -m644 "$DOT/system/etc/${f#/etc/}" "$f" && ok "$f"
  done < <(entries "$DOT/system/etc-files.txt")
  sudo systemd-tmpfiles --create /etc/tmpfiles.d/thp.conf &>/dev/null
  command -v limine-update >/dev/null && sudo limine-update &>/dev/null && ok "boot entries regenerated"
fi

# ------------------------------------------------------------------ services

step "Services (only units that exist here; Mac and login-manager units skipped)"
while read -r u; do
  [[ $u =~ $SKIP_UNIT ]] && continue
  systemctl cat "$u" &>/dev/null || continue
  systemctl is-enabled "$u" &>/dev/null && continue
  sudo systemctl enable "$u" &>/dev/null && ok "$u" || warn "could not enable $u"
done < <(entries "$DOT/system/services.txt")
while read -r u; do
  [[ $u =~ $SKIP_UNIT ]] && continue
  systemctl --user cat "$u" &>/dev/null || continue
  systemctl --user is-enabled "$u" &>/dev/null && continue
  systemctl --user enable "$u" &>/dev/null && ok "user: $u" || warn "could not enable user $u"
done < <(entries "$DOT/system/user-services.txt")

# ------------------------------------------------------------------ links

step "Linking dotfiles"
link_claude=0
confirm claude "Also link the Claude Code memory folders from the repo (written on the Macs)?" false && link_claude=1
while IFS= read -r rel; do
  [[ $rel == .config/omarchy ]] && continue
  [[ $rel == .claude/projects/* ]] && ((!link_claude)) && continue
  link "$rel"
done < <(entries "$DOT/links.txt")

step "Linking ~/.config/omarchy item by item"
if [[ -L $OMA ]]; then backup "$OMA"; fi
mkdir -p "$OMA/plugins"
for item in "$REPO_HOME"/.config/omarchy/*; do
  name=$(basename "$item")
  [[ $name == plugins || $name == shell.json ]] && continue
  link ".config/omarchy/$name"
done

# ------------------------------------------------------------------ plugins

step "Installing picked plugins"
for id in "${picked[@]}"; do
  dst="$OMA/plugins/$id"
  if [[ -n ${GITURL[$id]:-} ]]; then
    if [[ -d $dst/.git ]]; then
      git -C "$dst" pull -q --ff-only && ok "$id (updated)"
    else
      [[ -e $dst || -L $dst ]] && backup "$dst"
      git clone -q "${GITURL[$id]}" "$dst" && ok "$id (cloned)"
    fi
  else
    link ".config/omarchy/plugins/$id"
  fi
done

if [[ $PICKED == *" io.github.thisisgm.omapods "* ]]; then
  pods="$OMA/plugins/io.github.thisisgm.omapods"
  if [[ -x $pods/setup && ! -x $HOME/.local/bin/librepods ]]; then
    step "Building AirPods daemon (omapods)"
    "$pods/setup" || warn "omapods setup failed; re-run $pods/setup"
  fi
fi

# Plugins from the repo that were NOT picked but are linked from an earlier run.
for id in "${ORDER[@]}"; do
  [[ $PICKED == *" $id "* ]] && continue
  dst="$OMA/plugins/$id"
  [[ -L $dst || -e $dst ]] && backup "$dst"
done

step "Writing shell.json for the picked plugins"
mkdir -p "$BACKUP/.config/omarchy"
[[ -e $OMA/shell.json ]] && cp -L "$OMA/shell.json" "$BACKUP/.config/omarchy/shell.json" && warn "backed up .config/omarchy/shell.json"
python3 -I - "$REPO_HOME/.config/omarchy/shell.json" "$OMA/shell.json" "${picked[@]}" <<'PY'
import json, sys, os
repo_path, cur_path, picked = sys.argv[1], sys.argv[2], set(sys.argv[3:])
repo = json.load(open(repo_path))
try:
    cur = json.load(open(cur_path))
except Exception:
    cur = {}

# Repo plugin -> stock plugin it replaces (None = drop when not picked).
REPLACES = {
    "andrei.workspaces": "omarchy.workspaces",
    "andreinita21.omamonitor": "omarchy.monitor",
    "custom.media": None,
    "io.github.thisisgm.omapods": None,
}
CLONE_OF = {
    "andrei.lock": "omarchy.lock",
    "andrei.idle": "omarchy.idle",
    "andrei.background": "omarchy.background",
    "custom.media": "omarchy.media",
}
REPO_IDS = set(REPLACES) | set(CLONE_OF) | {
    "andrei.bar", "andrei.gaps", "andrei.rounding-blur", "charlieras262.omablur"}

def keep(entry_id):
    return entry_id not in REPO_IDS or entry_id in picked

out = json.loads(json.dumps(repo))
bar = out.setdefault("bar", {})
if "andrei.bar" not in picked:
    bar.pop("id", None)
    transparent = bar.pop("transparent", None)
    bar["background"] = cur.get("bar", {}).get("background", "transparent" if transparent else "opaque")

layout = bar.setdefault("layout", {})
for section, items in list(layout.items()):
    new = []
    for e in items:
        i = e.get("id")
        if keep(i):
            new.append(e)
        elif REPLACES.get(i):
            new.append({"id": REPLACES[i]})
    layout[section] = new
# Keep this machine's tray contents (e.g. superwhisper.panel).
cur_tray = cur.get("bar", {}).get("layout", {}).get("tray", [])
have = {e.get("id") for e in layout.get("tray", [])}
layout["tray"] = layout.get("tray", []) + [e for e in cur_tray if e.get("id") not in have]

plugins = [p for p in out.get("plugins", []) if keep(p.get("id"))]
have = {p.get("id") for p in plugins}
plugins += [p for p in cur.get("plugins", []) if p.get("id") not in have]
out["plugins"] = plugins

# Only switch off a stock plugin when its replacement was picked.
disabled = [d for d in out.get("disabledPlugins", [])
            if not any(src == d and clone not in picked for clone, src in CLONE_OF.items())]
for d in cur.get("disabledPlugins", []):
    if d not in disabled:
        disabled.append(d)
if disabled: out["disabledPlugins"] = disabled
else: out.pop("disabledPlugins", None)

restores = [r for r in out.get("cloneSourceRestores", []) if r in picked]
if restores: out["cloneSourceRestores"] = restores
else: out.pop("cloneSourceRestores", None)

for key in ("dock",):
    if key in cur and key not in out:
        out[key] = cur[key]

if os.path.islink(cur_path):
    os.unlink(cur_path)
tmp = cur_path + ".tmp"
with open(tmp, "w") as f:
    json.dump(out, f, indent=2)
    f.write("\n")
os.replace(tmp, cur_path)
print("  wrote", cur_path)
print("  disabled stock plugins:", ", ".join(out.get("disabledPlugins", [])) or "none")
PY

# ------------------------------------------------------------------ apps

if confirm dev "Install dev tooling (mise tools, ble.sh, rustup)?"; then
  step "mise tools"
  mise install -y && ok "mise"
  if [[ ! -f $HOME/.local/share/blesh/ble.sh ]]; then
    tmp=$(mktemp -d)
    curl -fsSL https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly.tar.xz \
      | tar xJf - -C "$tmp" && bash "$tmp"/ble-nightly/ble.sh --install "$HOME/.local/share" && ok "ble.sh"
    rm -rf "$tmp"
  fi
  if [[ ! -x $HOME/.cargo/bin/rustup ]]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path && ok "rustup"
  fi
fi

# ------------------------------------------------------------------ desktop state

step "Removing default launchers you deleted"
while IFS= read -r n; do
  [[ -e $HOME/.local/share/applications/$n.desktop ]] || continue
  omarchy-webapp-remove "$n" &>/dev/null || omarchy-tui-remove "$n" &>/dev/null \
    || rm -f "$HOME/.local/share/applications/$n.desktop"
  ok "$n"
done < <(entries "$DOT/omarchy/apps-remove.txt")

step "Cloning git themes"
while read -r path url; do
  [[ $path == themes/* ]] || continue
  dst="$OMA/$path"
  if [[ -d $dst/.git ]]; then git -C "$dst" pull -q --ff-only && ok "$path (updated)"
  else git clone -q "$url" "$dst" && ok "$path"; fi
done < <(entries "$DOT/omarchy/git-clones.txt")

confirm dconf "Load GTK/GNOME settings (dconf.ini)?" && dconf load / < "$DOT/dconf.ini" && ok "dconf loaded"

step "Omarchy state, theme and wallpaper"
st="$HOME/.local/state/omarchy"
mkdir -p "$st"
for f in bar-mode transition-background transition-theme; do
  [[ -f $DOT/state/$f ]] && cp "$DOT/state/$f" "$st/$f"
done
for d in defaults powerprofiles workspace-layouts; do
  [[ -d $DOT/state/$d ]] && mkdir -p "$st/$d" && cp -r "$DOT/state/$d/." "$st/$d/"
done
fc-cache -f &>/dev/null
theme=$(cat "$DOT/state/theme.name") bg=$(cat "$DOT/state/background.name")
omarchy theme set "$theme" && ok "theme $theme"
[[ -f $st/current/theme/backgrounds/$bg ]] && omarchy theme bg set "$st/current/theme/backgrounds/$bg" && ok "background $bg"

command -v andrei-look >/dev/null && andrei-look apply && ok "rounding, blur and opacity (andrei-look)"
hyprctl reload &>/dev/null
errors=$(hyprctl configerrors 2>/dev/null)
[[ -n $errors && $errors != *"no errors"* ]] && { warn "Hyprland config errors:"; echo "$errors"; }
omarchy restart shell &>/dev/null && ok "shell restarted"

step "Done"
cat <<EOF
  - Vault was NOT restored (by design). Log in to apps manually.
  - Backups of everything replaced: ${BACKUP/#$HOME/\~}
  - Check ~/.config/hypr/monitors.lua matches this machine's displays.
  - Test the lock screen now with SUPER+CTRL+L before rebooting.
  - Change plugins later: run ./restore again, or use the shell's plugin settings.
EOF

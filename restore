#!/bin/bash
# Restore this ThinkPad T14 Gen 5 setup onto a fresh Omarchy install.
#
#   ./restore            (./dot install runs this too)
#
# What you get, and nothing else:
#   - configs and scripts from links.txt (Hyprland, terminals, nvim, bash, ...)
#   - shell plugins: andrei.bar, andrei.workspaces, andrei.gaps,
#     andrei.rounding-blur, andreinita21.omamonitor, custom.media (Music Flow)
#   - themes: andrei-nita, cookie-monster, neon-purple, ocult-records, matrix,
#     neon-dusk, plus the stock jade-horse, osaka-jade, starship, tokyo-night.
#     The other stock themes are hidden (omarchy/themes-remove.txt).
#   - ble.sh (terminal autosuggestions / completion)
#
# Safety rules learned the hard way (three reinstalls):
#   - Omarchy's own lock, idle and background stay in charge. No forks of them.
#   - Never touches SDDM, the vault, boot-freeze or the /etc tweaks.
#   - Backs up first and installs ~/desktop-rescue.sh (see ./rescue).
#   - Before it finishes it checks the login path: ~/.profile must source cleanly
#     under /bin/sh (uwsm does this at login; a failing line there = endless
#     return to the login screen), and Hyprland must report no config errors.
#
# Every replaced file goes to ~/.local/state/dotfiles-backup/<timestamp>/.
# Non-interactive: RESTORE_YES="pkgs dev dconf" picks optional steps.

set -uo pipefail

DOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_HOME="$DOT/home"
BACKUP="$HOME/.local/state/dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
SAFE="$HOME/.local/state/dotfiles-safety"
OMA="$HOME/.config/omarchy"

c_blue=$'\e[34m' c_green=$'\e[32m' c_yellow=$'\e[33m' c_red=$'\e[31m' c_off=$'\e[0m'
step() { printf '\n%s==> %s%s\n' "$c_blue" "$*" "$c_off"; }
ok()   { printf '  %s✓%s %s\n' "$c_green" "$c_off" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_yellow" "$c_off" "$*"; }
err()  { printf '  %s✗%s %s\n' "$c_red" "$c_off" "$*"; }
entries() { [[ -f $1 ]] && sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$'; }
confirm() { # confirm <key> <question>; default no
  if [[ ! -t 0 ]] || ! command -v gum >/dev/null; then [[ " ${RESTORE_YES:-} " == *" $1 "* ]]; return; fi
  gum confirm --default=false "$2"
}

backup() {
  local target=$1 rel=${1#"$HOME"/}
  mkdir -p "$BACKUP/$(dirname "$rel")"
  mv "$target" "$BACKUP/$rel"
  warn "backed up $rel"
}

link() { # link <rel path under $HOME>
  local rel=$1 src="$REPO_HOME/$1" dst="$HOME/$1"
  [[ -e $src || -L $src ]] || { warn "not in repo: $rel"; return; }
  [[ -L $dst && $(readlink "$dst") == "$src" ]] && return
  [[ -e $dst || -L $dst ]] && backup "$dst"
  mkdir -p "$(dirname "$dst")"
  ln -s "$src" "$dst" && ok "$rel"
}

profile_ok() { # exactly what uwsm's prepare-env.sh does at login
  env -i HOME="$HOME" PATH=/usr/bin:/bin /bin/sh -c '[ -f /etc/profile ] && . /etc/profile; [ -f "$HOME/.profile" ] && . "$HOME/.profile"; true' >/dev/null 2>&1
}

# ------------------------------------------------------------------ preflight

command -v omarchy >/dev/null || { err "Omarchy not found."; exit 1; }
[[ $EUID -eq 0 ]] && { err "Run as your user, not root."; exit 1; }
[[ $HOME == "$(cat "$DOT/.source-home" 2>/dev/null)" ]] \
  || { err "This repo's paths are for $(cat "$DOT/.source-home"); this restore expects the same home path."; exit 1; }

step "Safety net"
mkdir -p "$SAFE"
if ! ls "$SAFE"/pre-restore-*.tar.gz &>/dev/null; then
  ( cd "$HOME" && tar -czf "$SAFE/pre-restore-$(date +%Y%m%d-%H%M%S).tar.gz" \
      --exclude=.config/omarchy/themes .config .local/bin .local/share/applications \
      $(for f in .bashrc .bash_profile .profile .XCompose; do [[ -e $f && ! -L $f ]] && echo "$f"; done) 2>/dev/null )
  ok "configs archived to ${SAFE/#$HOME/\~}"
fi
if [[ ! -f $SAFE/shell.json.stock ]]; then
  cp "${OMARCHY_PATH:-/usr/share/omarchy}/config/omarchy/shell.json" "$SAFE/shell.json.stock" && ok "stock shell.json saved"
fi
ln -sfn "$DOT/rescue" "$HOME/desktop-rescue.sh" && ok "~/desktop-rescue.sh (run it from CTRL+ALT+F3 if login breaks)"

echo "  sudo is needed to hide the stock themes:"
sudo -v || { err "sudo failed"; exit 1; }

# ------------------------------------------------------------------ packages (optional)

if confirm pkgs "Install the packages from packages/pacman.txt that are missing here?"; then
  step "Packages"
  mapfile -t pkgs < <(comm -23 <(entries "$DOT/packages/pacman.txt" | sort -u) <(pacman -Qq | sort -u) \
    | comm -12 - <(pacman -Slq | sort -u))
  if ((${#pkgs[@]})) && ! sudo pacman -S --needed --noconfirm "${pkgs[@]}"; then
    warn "batch install failed; retrying one by one"
    for p in "${pkgs[@]}"; do sudo pacman -S --needed --noconfirm "$p" &>/dev/null && ok "$p" || warn "could not install $p"; done
  fi
fi

# ------------------------------------------------------------------ themes

step "Hiding stock themes not in your selection (pacman NoExtract)"
conf=/etc/pacman.conf lines=""
while read -r t; do
  grep -q "^NoExtract = usr/share/omarchy/themes/$t\$" "$conf" && continue
  lines+="NoExtract = usr/share/omarchy/themes/$t"$'\n'"NoExtract = usr/share/omarchy/themes/$t/*"$'\n'
done < <(entries "$DOT/omarchy/themes-remove.txt")
if [[ -n $lines ]]; then
  sudo cp "$conf" "$conf.bak.$(date +%s)"
  awk -v add="$lines" '{ print } /^\[options\]/ { printf "%s", add }' "$conf" | sudo tee "$conf.new" >/dev/null
  if pacman-conf --config "$conf.new" >/dev/null 2>&1; then sudo mv "$conf.new" "$conf" && ok "pacman.conf updated"
  else sudo rm -f "$conf.new"; err "generated pacman.conf was invalid; left it alone"; fi
fi
while read -r t; do
  [[ -d /usr/share/omarchy/themes/$t ]] && sudo rm -rf "/usr/share/omarchy/themes/$t" && ok "hid $t"
done < <(entries "$DOT/omarchy/themes-remove.txt")

# ------------------------------------------------------------------ links

step "Linking dotfiles"
[[ -L $OMA ]] && backup "$OMA"   # older layouts linked the whole directory
mkdir -p "$OMA/plugins"
while IFS= read -r rel; do
  [[ $rel == .claude/projects/* ]] && continue   # memory written on other machines
  link "$rel"
done < <(entries "$DOT/links.txt")

step "Cloning git themes and plugins"
while read -r path url; do
  dst="$OMA/$path"
  if [[ -d $dst/.git ]]; then git -C "$dst" pull -q --ff-only && ok "$path (updated)"
  else
    [[ -e $dst || -L $dst ]] && backup "$dst"
    git clone -q "$url" "$dst" && ok "$path"
  fi
done < <(entries "$DOT/omarchy/git-clones.txt")

step "Writing shell.json"
[[ -e $OMA/shell.json ]] && mkdir -p "$BACKUP/.config/omarchy" && cp -L "$OMA/shell.json" "$BACKUP/.config/omarchy/shell.json"
python3 -I - "$REPO_HOME/.config/omarchy/shell.json" "$OMA/shell.json" <<'PY'
import json, os, sys
repo_path, cur_path = sys.argv[1:3]
out = json.load(open(repo_path))
try: cur = json.load(open(cur_path))
except Exception: cur = {}
# Keep tray entries other tools added on this machine (e.g. superwhisper.panel).
tray = out.setdefault("bar", {}).setdefault("layout", {}).setdefault("tray", [])
have = {e.get("id") for e in tray}
tray += [e for e in cur.get("bar", {}).get("layout", {}).get("tray", []) if e.get("id") not in have]
# Safety: never switch off Omarchy's own lock, idle or background.
out["disabledPlugins"] = [d for d in out.get("disabledPlugins", [])
                          if d not in ("omarchy.lock", "omarchy.idle", "omarchy.background")]
if os.path.islink(cur_path): os.unlink(cur_path)
with open(cur_path + ".tmp", "w") as f:
    json.dump(out, f, indent=2); f.write("\n")
os.replace(cur_path + ".tmp", cur_path)
PY
ok "shell.json"

# ------------------------------------------------------------------ terminal

step "ble.sh (terminal autosuggestions)"
if [[ -f $HOME/.local/share/blesh/ble.sh ]]; then ok "already installed"
else
  tmp=$(mktemp -d)
  curl -fsSL https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly.tar.xz | tar xJf - -C "$tmp" \
    && bash "$tmp"/ble-nightly/ble.sh --install "$HOME/.local/share" >/dev/null && ok "ble.sh installed"
  rm -rf "$tmp"
fi

if confirm dev "Also install mise tools and rustup?"; then
  step "Dev tooling"
  mise install -y && ok "mise"
  [[ -x $HOME/.cargo/bin/rustup ]] || { curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path && ok "rustup"; }
fi

# ------------------------------------------------------------------ desktop state

step "Removing default launchers you deleted"
while IFS= read -r n; do
  [[ -e $HOME/.local/share/applications/$n.desktop ]] || continue
  omarchy-webapp-remove "$n" &>/dev/null || omarchy-tui-remove "$n" &>/dev/null \
    || rm -f "$HOME/.local/share/applications/$n.desktop"
  ok "$n"
done < <(entries "$DOT/omarchy/apps-remove.txt")

confirm dconf "Load GTK/GNOME settings (dconf.ini)?" && dconf load / < "$DOT/dconf.ini" && ok "dconf loaded"

step "Theme, wallpaper and look"
st="$HOME/.local/state/omarchy"
mkdir -p "$st"
for f in bar-mode transition-background transition-theme; do
  [[ -f $DOT/state/$f ]] && cp "$DOT/state/$f" "$st/$f"
done
for d in defaults powerprofiles workspace-layouts; do
  [[ -d $DOT/state/$d ]] && mkdir -p "$st/$d" && cp -r "$DOT/state/$d/." "$st/$d/"
done
fc-cache -f &>/dev/null
theme=$(cat "$DOT/state/theme.name") bg=$(cat "$DOT/state/background.name")
omarchy theme set "$theme" && ok "theme $theme"
[[ -f $st/current/theme/backgrounds/$bg ]] && omarchy theme bg set "$st/current/theme/backgrounds/$bg" && ok "background $bg"
command -v andrei-look >/dev/null && andrei-look apply && ok "rounding, blur and opacity (andrei-look)"
hyprctl reload &>/dev/null
omarchy restart shell &>/dev/null && ok "shell restarted"

# ------------------------------------------------------------------ verify login path

step "Checking the next login will work"
problems=0
if profile_ok; then ok "~/.profile sources cleanly under /bin/sh"
else
  mv "$HOME/.profile" "$SAFE/profile.broken.$(date +%s)"
  err "~/.profile failed under /bin/sh (would loop at the login screen); moved it to ${SAFE/#$HOME/\~}"
  problems=1
fi
bash -lc true &>/dev/null && ok "bash login shell starts" || { err "bash login shell fails (check ~/.bash_profile, ~/.bashrc)"; problems=1; }
errors=$(hyprctl configerrors 2>/dev/null)
if [[ -z $errors || $errors == *"no errors"* ]]; then ok "Hyprland config: no errors"
else err "Hyprland config errors:"; echo "$errors"; problems=1; fi
for p in "$OMA"/plugins/*; do
  id=$(basename "$p")
  [[ $id == *.lock || $id == *.idle || $id == *.background ]] && [[ $id != omarchy.* ]] \
    && { err "custom $id plugin present; it would compete with Omarchy's own"; problems=1; }
done
((problems)) || ok "all checks passed"

step "Done"
cat <<EOF
  - Backups of everything replaced: ${BACKUP/#$HOME/\~}
  - Test the lock now: SUPER+CTRL+L, unlock with your password. Only then reboot.
  - If login ever loops or the desktop breaks: CTRL+ALT+F3, log in,
    run ~/desktop-rescue.sh, then sudo reboot.
  - Vault was not restored. Run ./dot vault restore yourself if you want it.
EOF
